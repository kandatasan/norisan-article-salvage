      "expected_current_content_sha256": "9e85c198f9d140a4d5a566bafc9d20677f11ccd874a5c9a2d68296f68836af42",
      "marker": "tsurikue-en-photo-warehouse-20261113",
      "required_category": 49,
      "expected_media": {
        "4150": "/wp-content/uploads/2026/10/tsurikue-sakaiminato-4138-08.jpg",
        "4151": "/wp-content/uploads/2026/10/tsurikue-sakaiminato-4138-09.jpg",
        "4152": "/wp-content/uploads/2026/10/tsurikue-sakaiminato-4138-10.jpg",
        "4153": "/wp-content/uploads/2026/10/tsurikue-sakaiminato-4138-11.jpg",
        "4154": "/wp-content/uploads/2026/10/tsurikue-sakaiminato-4138-12.jpg",
