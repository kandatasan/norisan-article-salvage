      "position": "after",
      "anchor": "<!-- wp:paragraph -->\n<p><strong>すっごく……キレイです。</strong></p>\n<!-- /wp:paragraph -->",
      "html": "<!-- wp:image {\"id\":2727,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://tsurikue.com/wp-content/uploads/2026/08/img_0727.jpg\" alt=\"塩そば まえだの和そば\" class=\"wp-image-2727\"/></figure>\n<!-- /wp:image -->"
